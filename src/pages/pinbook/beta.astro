---
// 핀북 베타(TestFlight) 설치 안내. 지인 테스터에게 이 주소 하나만 보낸다.
// 검색엔진에는 안 보이게 noindex, 사이트맵에서도 뺀다(astro.config.mjs).
import PinbookPage from '../../layouts/PinbookPage.astro';

// TestFlight 공개 링크. Apple 베타 심사가 끝나 링크가 나오면 여기에 넣는다.
// 비어 있으면 설치 버튼이 잠긴 상태로 보인다.
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/Gap9VGbN';
const TESTFLIGHT_APP_STORE_URL = 'https://apps.apple.com/app/testflight/id899247664';
const CONTACT_EMAIL = 'pinbook.app@gmail.com';

const isInstallOpen = TESTFLIGHT_URL !== '';
const ICON_SRCSET = '/pinbook/icon.png 1x, /pinbook/icon@2x.png 2x';
---

<PinbookPage
	frontmatter={{
		title: '핀북 베타 설치 안내',
		description: 'iPhone에 TestFlight를 깔고 핀북 베타를 설치하는 방법',
		noindex: true,
	}}
	prose={false}
>
	<div class="beta">
		<div class="intro">
			<h1>핀북 베타 설치 안내</h1>
			<p class="lead">
				먼저 써 봐 주셔서 고마워요. iPhone에 Apple의 <b>TestFlight</b> 앱을 깔고, 거기서 핀북을
				설치해요. 3분이면 돼요.
			</p>
			<div class="req">
				<span>iPhone</span><span>iOS 16.4 이상</span><span>무료</span><span>로그인 없음</span>
			</div>
		</div>

		<div class="cta">
			{
				isInstallOpen ? (
					<>
						<a class="btn" href={TESTFLIGHT_URL}>
							TestFlight로 핀북 설치하기
						</a>
						<small>TestFlight 앱이 먼저 있어야 해요. 없으면 아래 1번부터.</small>
					</>
				) : (
					<>
						<span class="btn" role="link" aria-disabled="true">
							곧 열려요 · Apple 베타 심사 중
						</span>
						<small>심사는 보통 하루 안에 끝나요. 그동안 1번(TestFlight 받기)을 먼저 해 두세요.</small>
					</>
				)
			}
		</div>

		<section class="section">
			<h2>설치하는 법</h2>
			<ol class="steps">
				<li>
					<b>App Store에서 TestFlight 받기</b>
					<p>
						<a href={TESTFLIGHT_APP_STORE_URL}>App Store</a>에서 "TestFlight"를 검색해 <b>받기</b>를
						눌러요. Apple이 만든 무료 앱이에요.
					</p>
					<div class="fig" aria-hidden="true">
						<div class="mini">
							<div class="row">
								<span class="ic tf">✈</span>
								<span class="t"><b>TestFlight</b><small>Apple · 개발자 도구</small></span>
								<span class="pill hl">받기</span>
							</div>
						</div>
					</div>
				</li>
				<li>
					<b>위 버튼 누르고 수락 → 설치</b>
					{
						isInstallOpen ? (
							<p>
								이 페이지의 <b>TestFlight로 핀북 설치하기</b>를 누르면 TestFlight가 열려요. <b>수락</b>을
								누르고, 이어서 <b>설치</b>를 눌러요.
							</p>
						) : (
							<p>
								심사가 끝나면 위 버튼이 열려요. 그 버튼을 누르면 TestFlight가 열려요. <b>수락</b>을 누르고,
								이어서 <b>설치</b>를 눌러요.
							</p>
						)
					}
					<div class="fig" aria-hidden="true">
						<div class="mini">
							<div class="row">
								<span class="ic pb"><img src="/pinbook/icon.png" srcset={ICON_SRCSET} alt="" /></span>
								<span class="t"><b>핀북</b><small>베타 테스트에 초대됨</small></span>
								<span class="pill go hl">수락</span>
							</div>
							<div class="row next">
								<span class="ic-space"></span>
								<span class="t"><small>그다음</small></span>
								<span class="pill">설치</span>
							</div>
						</div>
					</div>
				</li>
				<li>
					<b>홈 화면에서 핀북 열기</b>
					<p>
						이름 앞 <span class="beta-dot" aria-hidden="true">•</span> <b>주황 점</b>은 베타 버전이라는 표시예요. 새 버전이 나오면
						TestFlight가 알려 줘요.
					</p>
					<div class="fig" aria-hidden="true">
						<div class="mini">
							<div class="home">
								<span class="app"><i></i>사진</span>
								<span class="app"><i></i>지도</span>
								<span class="app me">
									<i><img src="/pinbook/icon.png" srcset={ICON_SRCSET} alt="" /></i>
									<span><em>•</em> 핀북</span>
								</span>
								<span class="app"><i></i>설정</span>
							</div>
						</div>
					</div>
				</li>
			</ol>
		</section>

		<section class="section">
			<h2>이런 걸 봐 주세요</h2>
			<div class="box">
				<ul>
					<li>여행 사진 몇 장을 골라 지도에 꽂아 보기</li>
					<li>사진에 위치가 없을 때 도시 찾기가 잘 되는지</li>
					<li>글자를 크게 쓰시면 그 상태로 화면이 깨지지 않는지</li>
					<li>헷갈렸던 순간, 멈칫했던 화면</li>
				</ul>
			</div>
		</section>

		<section class="section">
			<h2>의견 보내기</h2>
			<p class="lead small">
				앱을 쓰다가 <b>화면을 캡처</b>하면 TestFlight가 "베타 피드백 보내기"를 띄워요. 거기에 한 줄 적어
				보내면 바로 저한테 와요. 메일도 좋아요.
			</p>
			<div class="mail">
				<code id="contact-mail">{CONTACT_EMAIL}</code>
				<button type="button" id="copy-mail" data-email={CONTACT_EMAIL}>주소 복사</button>
				<span class="sr-only" id="copy-status" role="status" aria-live="polite"></span>
			</div>
		</section>

		<section class="faq">
			<h2>자주 묻는 것</h2>
			<details>
				<summary>"이 베타는 가득 찼어요"라고 나와요</summary>
				<p>테스터 자리가 다 찬 거예요. 메일로 알려 주시면 자리를 늘릴게요.</p>
			</details>
			<details>
				<summary>90일이 지나면 앱이 안 열려요</summary>
				<p>
					베타 빌드는 90일 동안 써요. 그 전에 새 버전을 올리고, TestFlight가 업데이트를 알려 줘요. 기록은
					그대로 남아요.
				</p>
			</details>
			<details>
				<summary>정식 출시되면 기록은 어떻게 되나요</summary>
				<p>핀북을 지우지 말고 App Store 버전으로 그대로 덮어 설치하면 기록이 이어져요.</p>
			</details>
			<details>
				<summary>사진이 어디로 올라가나요</summary>
				<p>
					아무 데도 안 올라가요. 사진과 기록은 내 iPhone 안에만 있어요.
					<a href="/pinbook/privacy">개인정보 처리방침</a>
				</p>
			</details>
			<details>
				<summary>안드로이드는 안 되나요</summary>
				<p>지금은 iPhone만 돼요.</p>
			</details>
		</section>
	</div>
</PinbookPage>

<script>
	// 메일 주소 복사. 클립보드가 막혀 있어도 주소 글자를 선택해 두어 직접 복사할 수 있게 한다.
	// 결과 문구는 화면 낭독기용 status 영역에 알리고, 버튼 글자는 짧게 바꿨다가 되돌린다.
	const button = document.getElementById('copy-mail');
	const mail = document.getElementById('contact-mail');
	const status = document.getElementById('copy-status');
	const BUTTON_LABEL = '주소 복사';
	const RESET_DELAY_MS = 2000;
	let resetTimer: ReturnType<typeof setTimeout> | undefined;

	if (button instanceof HTMLButtonElement && mail && status) {
		const showResult = (buttonText: string, message: string) => {
			button.textContent = buttonText;
			status.textContent = message;
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				button.textContent = BUTTON_LABEL;
				status.textContent = '';
			}, RESET_DELAY_MS);
		};

		button.addEventListener('click', async () => {
			const range = document.createRange();
			range.selectNodeContents(mail);
			const selection = window.getSelection();
			selection?.removeAllRanges();
			selection?.addRange(range);

			try {
				await navigator.clipboard.writeText(button.dataset.email ?? '');
				showResult('복사됨', '주소를 복사했어요');
			} catch {
				showResult('선택됨', '주소를 선택했어요. 직접 복사해 주세요');
			}
		});
	}
</script>

<style>
	.beta {
		display: grid;
		gap: 22px;
		font-size: 15px;
		line-height: 1.65;
	}
	.beta a {
		color: var(--pb-accent);
	}
	.intro {
		display: grid;
		gap: 10px;
	}
	h1 {
		font-size: clamp(26px, 5vw, 30px);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.25;
		margin: 0;
		color: var(--pb-fg);
	}
	h2 {
		font-size: 18px;
		letter-spacing: -0.02em;
		margin: 0;
		color: var(--pb-fg);
	}
	b {
		color: var(--pb-fg);
	}
	.lead {
		margin: 0;
		color: var(--pb-muted);
	}
	.lead.small {
		font-size: 14px;
	}
	.req {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.req span {
		font-size: 12.5px;
		border: 1px solid var(--pb-line);
		background: var(--pb-surface);
		border-radius: 999px;
		padding: 2px 10px;
		color: var(--pb-muted);
	}

	/* ── 설치 버튼 ── */
	.cta {
		display: grid;
		gap: 6px;
	}
	.btn {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 8px;
		min-height: 52px;
		padding-inline: 16px;
		border-radius: 14px;
		background: var(--pb-accent);
		font-weight: 700;
		font-size: 16px;
		text-align: center;
		text-decoration: none;
	}
	.beta a.btn,
	.beta a.btn:hover {
		color: var(--pb-on-accent);
	}
	.btn[aria-disabled='true'] {
		background: var(--pb-surface);
		color: var(--pb-muted);
		border: 1px dashed var(--pb-line);
		cursor: default;
	}
	.cta small {
		color: var(--pb-muted);
		font-size: 12.5px;
		text-align: center;
	}

	/* ── 설치 단계 ── */
	.section {
		display: grid;
		gap: 14px;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 18px;
		counter-reset: step;
	}
	.steps li {
		display: grid;
		grid-template-columns: 28px minmax(0, 1fr);
		gap: 4px 12px;
		counter-increment: step;
	}
	.steps li::before {
		content: counter(step);
		grid-row: span 3;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--pb-fg);
		color: var(--pb-bg);
		display: grid;
		place-items: center;
		font-weight: 700;
		font-size: 14px;
	}
	.steps li > b {
		font-size: 15.5px;
	}
	.steps p {
		margin: 0;
		color: var(--pb-muted);
		font-size: 14px;
	}

	/* 단계 그림: 앱 화면을 단순하게 그린 것. 누를 곳은 포인트색 테두리. */
	.fig {
		margin-top: 6px;
		border-radius: 14px;
		background: var(--pb-surface);
		border: 1px solid var(--pb-line);
		padding: 12px;
		display: flex;
		justify-content: center;
	}
	.mini {
		width: 220px;
		max-width: 100%;
		border-radius: 18px;
		background: var(--pb-bg);
		border: 1px solid var(--pb-line);
		padding: 12px;
		display: grid;
		gap: 8px;
		font-size: 11.5px;
		line-height: 1.3;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.row.next {
		opacity: 0.75;
	}
	.ic,
	.ic-space {
		width: 34px;
		height: 34px;
		flex: none;
	}
	.ic {
		border-radius: 9px;
		display: grid;
		place-items: center;
		font-size: 16px;
		font-weight: 800;
		color: #fff;
	}
	/* Apple 아이콘을 흉내 내지 않은 단순한 파란 사각 + 비행기. */
	.ic.tf {
		background: linear-gradient(160deg, #5aa9f5, #1f6fd6);
	}
	.ic.pb {
		background: var(--pb-sea);
		overflow: hidden;
	}
	.ic.pb img,
	.app.me i img {
		width: 100%;
		height: 100%;
		display: block;
	}
	.t {
		display: grid;
		min-width: 0;
		white-space: nowrap;
	}
	.t small {
		color: var(--pb-muted);
		font-size: 10px;
	}
	.pill {
		flex: none;
		white-space: nowrap;
		margin-left: auto;
		border-radius: 999px;
		padding: 3px 12px;
		font-weight: 700;
		font-size: 11px;
		background: var(--pb-sea);
		color: #1f6fd6;
	}
	.pill.go {
		background: #1f6fd6;
		color: #fff;
	}
	.hl {
		outline: 2px solid var(--pb-accent);
		outline-offset: 2px;
	}
	.home {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
		justify-items: center;
	}
	.app {
		display: grid;
		gap: 3px;
		justify-items: center;
		font-size: 9.5px;
		color: var(--pb-muted);
		white-space: nowrap;
	}
	.app i {
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: var(--pb-line);
		display: block;
	}
	.app.me i {
		background: none;
		overflow: hidden;
	}
	.app.me {
		color: var(--pb-fg);
		font-weight: 700;
	}
	/* 베타 앱 이름 앞에 붙는 iOS 의 주황 점 색. 본문에서는 장식 점에만 쓰고 글자는 본문 색. */
	.app.me em,
	.beta-dot {
		font-style: normal;
		color: #e8862a;
	}

	/* ── 봐 줄 것 / 의견 ── */
	.box {
		border-radius: 14px;
		background: var(--pb-surface);
		border: 1px solid var(--pb-line);
		padding: 14px 16px;
	}
	.box ul {
		margin: 0;
		padding-left: 18px;
		display: grid;
		gap: 4px;
		font-size: 14px;
	}
	.mail {
		display: flex;
		gap: 8px;
		align-items: center;
		flex-wrap: wrap;
		font-size: 14px;
	}
	.mail code {
		font-family: var(--font-mono);
		font-size: 13px;
		background: var(--pb-bg);
		border: 1px solid var(--pb-line);
		border-radius: 8px;
		padding: 2px 8px;
		color: var(--pb-fg);
		/* 복사 버튼이 안 될 때 한 번 눌러 주소 전체를 고를 수 있게. */
		user-select: all;
		-webkit-user-select: all;
	}
	.mail button {
		font: inherit;
		font-size: 12.5px;
		border: 1px solid var(--pb-line);
		background: var(--pb-surface);
		color: var(--pb-fg);
		border-radius: 999px;
		padding: 2px 10px;
		cursor: pointer;
	}

	/* ── 자주 묻는 것 ── */
	.faq h2 {
		margin-bottom: 6px;
	}
	details {
		border-bottom: 1px solid var(--pb-line);
		padding: 10px 0;
	}
	summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 14.5px;
		color: var(--pb-fg);
	}
	details p {
		margin: 6px 0 0;
		color: var(--pb-muted);
		font-size: 14px;
	}
</style>
