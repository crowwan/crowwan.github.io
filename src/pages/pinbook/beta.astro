---
// 핀북 베타(TestFlight) 테스터에게 보냈던 주소. 정식 출시 뒤에는 App Store 로 옮겨 가는 짧은 안내만 둔다.
// 검색엔진에는 안 보이게 noindex, 사이트맵에서도 뺀다(astro.config.mjs).
import { PINBOOK_APP_STORE_URL } from '../../data/pinbook';
import PinbookPage from '../../layouts/PinbookPage.astro';
---

<PinbookPage
	frontmatter={{
		title: '핀북이 정식 출시됐어요',
		description: '베타로 쓰시던 핀북을 지우지 말고 App Store 버전으로 덮어 설치하면 기록이 이어져요',
		noindex: true,
	}}
	prose={false}
>
	<div class="launch">
		<div class="intro">
			<h1>핀북이 정식 출시됐어요</h1>
			<p class="lead">베타를 써 주셔서 고마워요. 이제 App Store에서 받을 수 있어요.</p>
		</div>

		<a class="btn" href={PINBOOK_APP_STORE_URL}>App Store에서 받기</a>

		<section class="box">
			<h2>베타로 쓰시던 분은</h2>
			<p>
				핀북을 <b>지우지 말고</b> App Store 버전을 덮어 설치하면 기록이 이어져요. 앱을 지우면 기록도 함께
				지워져요.
			</p>
		</section>

		<p class="more">궁금한 점이나 의견은 <a href="/pinbook/support">핀북 지원</a> 페이지에 있어요.</p>
	</div>
</PinbookPage>

<style>
	.launch {
		display: grid;
		gap: 22px;
		font-size: 15px;
		line-height: 1.65;
		/* 한글 낱말 중간에서 줄이 바뀌지 않게 */
		word-break: keep-all;
	}
	.launch a {
		color: var(--pb-accent);
	}
	.intro {
		display: grid;
		gap: 10px;
	}
	h1 {
		font-size: clamp(26px, 5vw, 30px);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.25;
		margin: 0;
		color: var(--pb-fg);
	}
	h2 {
		font-size: 16px;
		letter-spacing: -0.02em;
		margin: 0;
		color: var(--pb-fg);
	}
	b {
		color: var(--pb-fg);
	}
	p {
		margin: 0;
	}
	.lead {
		color: var(--pb-muted);
	}

	.btn {
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 52px;
		padding-inline: 16px;
		border-radius: 14px;
		background: var(--pb-accent);
		font-weight: 700;
		font-size: 16px;
		text-align: center;
		text-decoration: none;
	}
	.launch a.btn,
	.launch a.btn:hover {
		color: var(--pb-on-accent);
	}

	.box {
		display: grid;
		gap: 6px;
		border-radius: 14px;
		background: var(--pb-surface);
		border: 1px solid var(--pb-line);
		padding: 14px 16px;
	}
	.box p {
		color: var(--pb-muted);
		font-size: 14px;
	}
	.more {
		color: var(--pb-muted);
		font-size: 14px;
	}
</style>
