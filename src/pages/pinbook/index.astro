---
// 핀북 소개(랜딩) 페이지.
// 첫 화면 = 누를 수 있는 지도(사진이 날아가 핀이 섬) + 앱 나라 지도 화면 /
// 쓰는 법 = 스크롤 따라 바뀌는 폰(찾기 → 칠하기 → 사진 열기 → 돌아보기) / 약속 세 가지 / App Store 받기.
// JS 가 없어도 카드 문구·폰 화면은 HTML 로 읽힌다. 인터랙션은 src/scripts/pinbook-landing.ts.
import { PINBOOK_APP_STORE_URL } from '../../data/pinbook';
import PinbookPage from '../../layouts/PinbookPage.astro';

// App Store 스크린샷 원본(1206×2622, 틀 없음)을 같은 비율로 줄인 앱 화면(600×1304, 2x)
const SCREEN = { width: 600, height: 1304 };
const HERO_SCREEN = {
	img: '/pinbook/screens/country-map.webp',
	alt: '일본 지도에 교토·오사카·나라 사진 핀이 선 핀북 화면',
};

const STEPS = [
	{
		no: '1 · 찾기',
		title: '사진첩에서 지난 여행을 찾아요',
		body: "사진첩을 훑어 여행 후보를 찾고, 여행마다 사진을 6장까지 골라 둬요. 위치가 없는 사진은 '날짜로 찾기'에서 언제, 어디였는지 알려 주면 찾아요.",
		img: '/pinbook/screens/found-trips.webp',
		alt: '지난 여행 6개를 찾았다는 목록. 시드니·서귀포·오사카·파리·방콕 여행마다 날짜와 고른 사진 장수가 보이는 화면',
	},
	{
		no: '2 · 칠하기',
		title: '핀하면 다녀온 나라가 칠해져요',
		body: '칠한 세계지도는 스토리 크기 한 장으로 공유해요.',
		img: '/pinbook/screens/world-night.webp',
		alt: '어두운 모드 세계지도. 다녀온 나라가 칠해져 있고 아래에 내 여행 6편이 보이는 화면',
	},
	{
		no: '3 · 사진 열기',
		title: '핀을 누르면 그 자리 사진이 열려요',
		body: '도시와 여행은 네 컷 사진으로 공유해요.',
		img: '/pinbook/screens/photo-detail.webp',
		alt: '오사카 지도에서 핀을 눌러 연 빨간 다리 사진. 아래에 오사카, 2026년 3월 5일 12:23 이 보이는 화면',
	},
	{
		no: '4 · 돌아보기',
		title: '지난 여행을 다시 꺼내 봐요',
		body: "핀한 사진은 여행별로 묶여 스토리처럼 넘겨 볼 수 있어요. 몇 해 전 이맘때 다녀온 여행이 있으면 홈 맨 위에 다시 떠요. 12월과 1월에는 '핀북 펼쳐 보기'로 그해 다녀온 나라와 도시를 넘겨 봐요.",
		img: '/pinbook/screens/recap.webp',
		alt: '어두운 모드 2026 핀북 펼쳐 보기 화면. 세계지도에 그해 다녀온 나라가 칠해지고 2026년 3개국, 도시 5곳이 적힌 화면',
	},
];

const PROMISES = [
	{ title: '내 iPhone 안에만', body: '사진과 사진에 담긴 위치는 iPhone 밖으로 보내지 않아요. 사진첩 전체 접근은 선택이에요.' },
	{ title: '로그인 없이', body: '계정을 만들 필요가 없어요. 열면 바로 시작해요.' },
	{ title: '비행기 안에서도', body: '인터넷이 없으면 내장 지도로 바뀌어 그대로 핀할 수 있어요.' },
];
---

<PinbookPage
	frontmatter={{
		title: '핀북',
		description: '사진첩 속 지난 여행을 찾아 다녀온 나라를 칠하고, 도시마다 사진 핀을 세우는 iOS 앱',
	}}
	prose={false}
	wide
>
	<div class="lp">
		<!-- 1 · 지도 -->
		<!-- 넓은 화면: 지도가 첫 화면 전체에 깔리고 카드·폰이 위에 뜸 / 좁은 화면: 카드 → 지도 띠 → 폰 -->
		<section class="hero" id="hero">
			<div class="w">
				<div class="card">
					<span class="eyebrow">iPhone 여행 사진 지도</span>
					<h1>여행 사진으로<br />내 세계지도를 칠해요</h1>
					<p class="lead">
						핀북은 사진에 담긴 위치와 날짜로 지난 여행을 찾아 드려요. 찾은 여행을 확인하고 핀하면 다녀온 나라가
						칠해지고, 도시마다 사진 핀이 서요.
					</p>
					<div class="cta">
						<a class="btn" href={PINBOOK_APP_STORE_URL}>App Store에서 받기</a>
						<a class="btn ghost" href="#how">어떻게 쓰나요</a>
					</div>
					<div class="stat" aria-live="polite">
						<div><b id="sCountry">0</b><span>나라</span></div>
						<div><b id="sPhoto">0</b><span>사진</span></div>
					</div>
					<span class="tap"><i></i>지도를 눌러 사진을 핀해 보세요</span>
				</div>
				<div class="map-band">
					<canvas id="map" role="img" aria-label="누르면 사진이 날아가 핀이 서는 지도"></canvas>
				</div>
				<div class="phone">
					<img
						src={HERO_SCREEN.img}
						width={SCREEN.width}
						height={SCREEN.height}
						fetchpriority="high"
						alt={HERO_SCREEN.alt}
					/>
				</div>
			</div>
		</section>

		<!-- 2 · 쓰는 법 -->
		<section class="how" id="how">
			<div class="w head rise pre">
				<span class="eyebrow">쓰는 법</span>
				<h2>사진첩 속 지난 여행이 지도에 남아요</h2>
			</div>
			<div class="w flow">
				<div class="stick">
					<div class="phone">
						<img
							id="stickImg"
							src={STEPS[0].img}
							width={SCREEN.width}
							height={SCREEN.height}
							loading="lazy"
							alt={STEPS[0].alt}
						/>
					</div>
				</div>
				<div class="steps">
					{
						STEPS.map((step, i) => (
							<div class:list={['step', { on: i === 0 }]} data-img={step.img} data-alt={step.alt}>
								<span class="no">{step.no}</span>
								<h3>{step.title}</h3>
								<p>{step.body}</p>
								<div class="phone sm inline">
									<img src={step.img} width={SCREEN.width} height={SCREEN.height} loading="lazy" alt={step.alt} />
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- 3 · 약속 -->
		<section class="band priv">
			<div class="w">
				{
					PROMISES.map((item) => (
						<div class="item rise pre">
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- 4 · 받기 -->
		<section class="band closing-band">
			<div class="w closing rise pre">
				<h2>App Store에서 무료로 받아요</h2>
				<p class="lead">가입도 광고도 없어요.</p>
				<div class="cta">
					<a class="btn" href={PINBOOK_APP_STORE_URL}>App Store에서 받기</a>
					<a class="btn ghost" href="/pinbook/support">의견 보내기</a>
				</div>
				<div class="chips"><span>iPhone</span><span>iOS 16.4 이상</span><span>무료</span></div>
			</div>
		</section>
	</div>
</PinbookPage>

<script>
	import '../../scripts/pinbook-landing';
</script>

<style>
	/* 랜딩 전용 토큰. 공용 색(--pb-*)은 PinbookPage 레이아웃에서 온다. */
	.lp {
		--lp-visited: #f4c7b2;
		--lp-visited-line: #e9a68a;
		--lp-land-line: #d5d2ca;
		--lp-ink: #15191d;
		--lp-ease: cubic-bezier(0.2, 0.8, 0.2, 1);

		color: var(--pb-fg);
		font-size: 16px;
		line-height: 1.6;
		letter-spacing: normal;
		/* 한글 낱말 중간에서 줄이 바뀌지 않게 */
		word-break: keep-all;
		overflow-x: clip;
	}
	@media (prefers-color-scheme: dark) {
		.lp {
			--lp-visited: #6b3a2c;
			--lp-visited-line: #8a4a36;
			--lp-land-line: #2f363f;
			--lp-ink: #05080b;
		}
	}

	.lp a {
		color: inherit;
	}
	.w {
		max-width: 1080px;
		margin: 0 auto;
		padding-left: max(20px, env(safe-area-inset-left, 0px));
		padding-right: max(20px, env(safe-area-inset-right, 0px));
	}
	h1 {
		font-size: clamp(32px, 5.6vw, 56px);
		line-height: 1.12;
		letter-spacing: -0.035em;
		margin: 0;
		text-wrap: balance;
		font-weight: 800;
	}
	h2 {
		font-size: clamp(24px, 3.4vw, 34px);
		line-height: 1.2;
		letter-spacing: -0.03em;
		margin: 0;
		text-wrap: balance;
		font-weight: 800;
	}
	h3 {
		margin: 0;
	}
	p {
		margin: 0;
	}
	.lead {
		font-size: clamp(16px, 1.8vw, 19px);
		color: var(--pb-muted);
		max-width: 34em;
	}
	/* 절 머리 라벨. 전역 .eyebrow 의 올캡스는 끄고, 한글이 벌어지지 않게 본문 글꼴로 */
	.eyebrow {
		text-transform: none;
		font-family: inherit;
		font-weight: 700;
		font-size: 13px;
		color: var(--pb-accent);
		letter-spacing: 0.04em;
	}
	.cta {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		align-items: center;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 50px;
		padding: 0 22px;
		border-radius: 14px;
		background: var(--pb-accent);
		border: 0;
		font: inherit;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
	}
	.lp .btn,
	.lp .btn:hover {
		color: var(--pb-on-accent);
	}
	.lp .btn.ghost,
	.lp .btn.ghost:hover {
		background: transparent;
		color: var(--pb-fg);
		border: 1px solid var(--pb-line);
	}
	.phone {
		width: min(290px, 100%);
		aspect-ratio: 9 / 19.5;
		border-radius: 44px;
		background: var(--lp-ink);
		padding: 10px;
		box-shadow: 0 24px 50px rgba(0, 0, 0, 0.2);
		flex: none;
	}
	.phone img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		border-radius: 35px;
		display: block;
	}
	.phone.sm {
		width: min(220px, 100%);
		border-radius: 34px;
		padding: 8px;
	}
	.phone.sm img {
		border-radius: 27px;
	}
	.band {
		padding-block: 80px;
	}

	/* 1 · 지도 */
	.hero {
		position: relative;
		background: var(--pb-sea);
		overflow: hidden;
		min-height: 640px;
	}
	/* 넓은 화면: 지도 띠가 첫 화면(.hero) 전체를 덮고, 카드·폰이 그 위에 뜬다 */
	.map-band {
		position: absolute;
		inset: 0;
		pointer-events: auto;
	}
	.map-band canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		cursor: crosshair;
		touch-action: manipulation;
	}
	.hero .w {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 32px;
		align-items: center;
		padding-block: 56px 64px;
		/* 카드·폰 밖(지도)은 캔버스가 클릭을 받는다 */
		pointer-events: none;
	}
	.hero .card {
		position: relative;
		z-index: 1;
		pointer-events: auto;
		background: color-mix(in srgb, var(--pb-bg) 90%, transparent);
		border-radius: 22px;
		padding: 26px;
		display: grid;
		gap: 18px;
		min-width: 0;
		backdrop-filter: blur(6px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
	}
	.hero .phone {
		position: relative;
		z-index: 1;
		pointer-events: auto;
		justify-self: center;
	}
	/* 좁은 화면: 카드가 지도를 덮지 않게 종이 바탕 카드 → 누를 수 있는 지도 띠 → 폰 순서로 쌓는다.
	   780px 은 스크립트의 땅 배치 전환 기준(pinbook-landing.ts narrowLayout)과 같아야 한다. */
	@media (max-width: 780px) {
		.hero {
			min-height: 0;
			background: var(--pb-bg);
		}
		.hero .w {
			grid-template-columns: 1fr;
			gap: 28px;
			padding-block: 28px 48px;
		}
		.hero .card {
			background: none;
			padding: 0;
			border-radius: 0;
			box-shadow: none;
			backdrop-filter: none;
		}
		.map-band {
			position: relative;
			inset: auto;
			height: 320px;
			/* 화면 양 끝까지 */
			margin-inline: calc(-1 * max(20px, env(safe-area-inset-left, 0px)));
			background: var(--pb-sea);
		}
		.hero .phone {
			width: min(240px, 70%);
		}
	}
	.stat {
		display: flex;
		gap: 22px;
		flex-wrap: wrap;
		font-variant-numeric: tabular-nums;
	}
	.stat div {
		display: grid;
	}
	.stat b {
		font-size: 28px;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--pb-fg);
	}
	.stat span {
		font-size: 13px;
		color: var(--pb-muted);
	}
	.stat b.bump {
		animation: lp-bump 0.45s var(--lp-ease);
	}
	@keyframes lp-bump {
		0% {
			transform: scale(1);
		}
		40% {
			transform: scale(1.25);
			color: var(--pb-accent);
		}
		100% {
			transform: scale(1);
		}
	}
	.tap {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13.5px;
		color: var(--pb-muted);
	}
	.tap i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--pb-accent);
		animation: lp-ping 1.8s infinite;
	}
	@keyframes lp-ping {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--pb-accent) 60%, transparent);
		}
		80%,
		100% {
			box-shadow: 0 0 0 10px transparent;
		}
	}

	/* 2 · 쓰는 법: 넓은 화면은 붙어 있는 폰 하나가 바뀌고, 폰 폭에선 장면마다 이미지 */
	.how {
		background: var(--pb-surface);
		border-block: 1px solid var(--pb-line);
	}
	.how .head {
		display: grid;
		gap: 12px;
		padding-top: 80px;
	}
	.flow {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: 56px;
		align-items: start;
		padding-block: 24px 80px;
	}
	.stick {
		position: sticky;
		top: calc(env(safe-area-inset-top, 0px) + 40px);
		display: grid;
		justify-items: center;
	}
	.stick img {
		transition: opacity 0.3s ease;
	}
	.step {
		min-height: 62vh;
		display: grid;
		align-content: center;
		gap: 12px;
		border-left: 2px solid var(--pb-line);
		padding-left: 24px;
		transition: border-color 0.3s;
	}
	.step.on {
		border-left-color: var(--pb-accent);
	}
	.step .no {
		font-weight: 700;
		letter-spacing: 0.02em;
		font-size: 13px;
		color: var(--pb-accent);
	}
	.step h3 {
		font-size: clamp(22px, 2.8vw, 30px);
		letter-spacing: -0.03em;
		line-height: 1.25;
	}
	.step p {
		color: var(--pb-muted);
		max-width: 30em;
	}
	.step .phone.inline {
		display: none;
	}
	@media (max-width: 820px) {
		.flow {
			grid-template-columns: 1fr;
		}
		.flow .stick {
			display: none;
		}
		.step {
			min-height: auto;
			padding-block: 28px;
		}
		.step .phone.inline {
			display: block;
			margin-top: 8px;
		}
	}

	/* 3 · 약속, 4 · 받기 */
	.priv .w {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
	@media (max-width: 780px) {
		.priv .w {
			grid-template-columns: 1fr;
		}
	}
	.priv .item {
		display: grid;
		gap: 6px;
		padding-top: 16px;
		border-top: 2px solid var(--pb-fg);
	}
	.priv h3 {
		font-size: 18px;
	}
	.priv p {
		color: var(--pb-muted);
		font-size: 15px;
	}
	.closing-band {
		padding-top: 0;
	}
	.closing {
		text-align: center;
		display: grid;
		gap: 18px;
		justify-items: center;
	}
	.closing .cta {
		justify-content: center;
	}
	.chips {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		justify-content: center;
	}
	.chips span {
		font-size: 13px;
		border: 1px solid var(--pb-line);
		border-radius: 999px;
		padding: 2px 10px;
		color: var(--pb-muted);
		background: var(--pb-surface);
	}

	/* 화면에 들어오면 살짝 떠오름. JS 가 있을 때만 아래로 내려 두고, 투명하게 숨기지는 않는다. */
	.rise {
		transition:
			opacity 0.6s var(--lp-ease),
			transform 0.6s var(--lp-ease);
	}
	.lp.is-js .rise.pre {
		transform: translateY(18px);
	}

	@media (prefers-reduced-motion: reduce) {
		.lp *,
		.lp *::before,
		.lp *::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
